# ─────────────────────────────────────────────────────────────
# GEO Creator Scout — backend environment
# Copy to .env and fill in.  NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ─── LLM provider (REQUIRED) ──────────────────────────────────
# ANTHROPIC_API_KEY=<LLM provider API key> — get one at console.anthropic.com
# (pay-per-token, no free tier).
ANTHROPIC_API_KEY=

# LLM model id. Default is fast/cheap, good for structured classification.
# Bump to a stronger model for deeper reasoning on nuanced GEO-fit judgements.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Search provider (active: Tavily) ──────────────────────────
# Tavily — free dev tier, no card (1,000 credits/mo dev key):
# https://app.tavily.com
# Chosen for Instagram creator discovery because it supports
# include_domains=["instagram.com"] to scope results to Instagram directly.
TAVILY_API_KEY=

# Which providers run, in priority order. Tavily is the active one.
SEARCH_PROVIDERS=tavily

# ─── Optional alternative search provider (NOT active by default) ──────────
# The SearchProvider abstraction retains Serper's implementation and tests in
# full — no code changes are needed to switch. To use it instead, set its key
# AND change SEARCH_PROVIDERS:
#
# Serper.dev (Google SERP) — free 2,500 one-time credits, no card:
# https://serper.dev
# SERPER_API_KEY=
# To use Serper instead:
# SEARCH_PROVIDERS=serper
#
# Brave Search — paid since Feb 2026 (card required):
# BRAVE_API_KEY=
# "keyless" — best-effort DuckDuckGo-HTML fallback, low reliability, opt-in only:
# SEARCH_PROVIDERS=tavily,keyless

# ─── Discovery / ranking knobs ───────────────────────────────
MAX_SEARCH_QUERIES=6
MAX_ANALYSIS_CANDIDATES=14
MAX_CANDIDATES=24
DEFAULT_RESULT_LIMIT=8
MIN_RESULT_LIMIT=5
MAX_RESULT_LIMIT=10

# Credibility gate: a creator must clear BOTH to make the shortlist. Does not
# change the 35/30/25/10 weighting formula — filters after scoring.
MIN_RELEVANCE_SCORE=40
MIN_RESULT_CONFIDENCE=0.35

# ─── Cache ───────────────────────────────────────────────────
CACHE_TTL_HOURS=24

# ─── HTTP ────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=12
ANTHROPIC_TIMEOUT_SECONDS=40

# ─── Server ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/geo_creator_scout.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
